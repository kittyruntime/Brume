{
  "name": "app",
  "version": "1.52.0",
  "description": "A modern home server dashboard for self-hosting apps, media and storage.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=10.18.0"
  },
  "scripts": {
    "test": "pnpm test:backend && pnpm test:worker",
    "test:backend": "pnpm --filter @app/backend test",
    "test:worker": "cd apps/root-worker && go test ./...",
    "pretypecheck": "pnpm --filter @app/database db:generate",
    "typecheck": "pnpm --filter @app/database exec tsc --noEmit && pnpm --filter @app/backend exec tsc --noEmit && pnpm --filter @app/dashboard exec vue-tsc -b",
    "smoke:backend": "node scripts/smoke-backend.mjs",
    "check:go": "test -z \"$(gofmt -l apps/root-worker)\" && cd apps/root-worker && go vet ./...",
    "verify": "pnpm lint && scripts/check-i18n.sh && pnpm check:go && pnpm typecheck && pnpm test && pnpm build && pnpm smoke:backend",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dev": "pnpm -r dev",
    "build": "pnpm --filter @app/backend build && pnpm --filter @app/dashboard build",
    "start": "pnpm -r start"
  },
  "keywords": [],
  "author": "kittyruntime",
  "license": "MPL-2.0",
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ],
    "overrides": {
      "brace-expansion": "5.0.9",
      "tsx": "4.23.12",
      "deepmerge-ts": "^8.0.0",
      "nanoid": "^3.3.18",
      "fast-uri": "^3.1.6"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  }
}
