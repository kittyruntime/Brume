model Alert {
  id          String   @id @default(uuid())
  source      String
  target      String
  message     String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  @@unique([source, target])
}

// Single settings row (id fixed to "default") — not a per-user preference, so it
// doesn't belong in User.preferences; not observed system state, so it doesn't
// belong in Alert. Threshold percentages the storage.disk-usage checker compares
// each Place's usage against.
model AlertThreshold {
  id                       String @id @default("default")
  diskUsageWarningPercent  Int    @default(80)
  diskUsageCriticalPercent Int    @default(90)
}
